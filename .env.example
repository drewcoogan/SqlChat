# SqlChat configuration
# Copy this file to .env and fill in your values. Never commit .env to source control.

# --- LLM Provider (anthropic | azureopenai) ---
SQLCHAT_PROVIDER=anthropic

# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-4-7

# --- Azure OpenAI ---
# AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
# AZURE_OPENAI_API_KEY=...
# AZURE_OPENAI_DEPLOYMENT=gpt-4o

# --- Database (for schema introspection) ---
# SQL_DIALECT=sqlserver   # sqlserver | postgresql
# CONNECTION_STRING=Server=.;Database=MyDb;Trusted_Connection=true;
