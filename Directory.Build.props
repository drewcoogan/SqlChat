<Project>
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- NuGet package metadata, shared by every packable project. Each project sets its own <Description>. -->
  <PropertyGroup>
    <Version>0.1.0</Version>
    <Authors>Drew Coogan</Authors>
    <Copyright>Copyright (c) 2026 Drew Coogan</Copyright>
    <PackageTags>sql;llm;text-to-sql;nl2sql;postgres;postgresql;sqlserver;anthropic;claude;openai</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/drewcoogan/SqlChat</PackageProjectUrl>
    <RepositoryUrl>https://github.com/drewcoogan/SqlChat</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Missing XML doc comments on public members; remove once the public API is documented. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>
</Project>
