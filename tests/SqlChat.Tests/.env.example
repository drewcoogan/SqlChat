# SqlChat integration test environment
# Copy this file to .env and fill in your values.
# .env is gitignored and must never be committed.
#
# Integration tests that need these values should skip (not fail) when they are absent.
# The xUnit assembly fixture loads this file via DotNetEnv at test startup.


# ---------------------------------------------------------------------------
# LLM — Anthropic
# ---------------------------------------------------------------------------

# Required for any test that calls the Anthropic API (SQL generation, end-to-end).
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the model used during tests. Defaults to claude-opus-4-7.
# Use a faster/cheaper model (e.g. claude-haiku-4-5-20251001) for local runs.
# ANTHROPIC_MODEL=claude-opus-4-7

# Optional: cap output tokens for test queries. Defaults to 2048.
# ANTHROPIC_MAX_OUTPUT_TOKENS=512


# ---------------------------------------------------------------------------
# Database — PostgreSQL
# ---------------------------------------------------------------------------

# Required for any test that hits a real Postgres instance
# (schema introspection, query execution, end-to-end pipeline).
SQLCHAT_CONNECTION_STRING=Host=localhost;Port=5432;Database=sqlchat_test;Username=postgres;Password=...

# Convenience breakdown if you prefer to compose the string in a fixture.
# These are read by the integration test helpers; they are NOT read by SqlChat itself.
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DATABASE=sqlchat_test
# POSTGRES_USERNAME=postgres
# POSTGRES_PASSWORD=...


# ---------------------------------------------------------------------------
# Retry behaviour — optional overrides for test runs
# ---------------------------------------------------------------------------

# Max Polly retries on transient DB errors. Defaults to 3.
# Set lower (e.g. 1) to keep test runs fast.
# SQLCHAT_QUERY_RETRY_MAX=1

# Max LLM fix-and-retry loops when generated SQL fails at execution. Defaults to 2.
# SQLCHAT_LLM_FIX_RETRY_MAX=1


# ---------------------------------------------------------------------------
# Test behaviour
# ---------------------------------------------------------------------------

# Set to "true" to run integration tests that make real API calls and DB connections.
# When absent or "false", those tests are skipped via [Trait("Category", "Integration")].
SQLCHAT_RUN_INTEGRATION_TESTS=false
