# SqlChat integration test environment
# Copy this file to .env and fill in your values.
# .env is gitignored and must never be committed.
#
# Tests are gated as follows:
#   SQLCHAT_RUN_INTEGRATION_TESTS=true  — master switch; all integration tests skip when absent or false
#   ANTHROPIC_API_KEY set               — enables Anthropic + Postgres end-to-end tests
#   OPENAI_API_KEY set                  — enables OpenAI connectivity test
#   SQLCHAT_SQLSERVER_CONNECTION_STRING set + ANTHROPIC_API_KEY set — enables SQL Server end-to-end tests
#
# Any combination works: set only what you have and the rest will skip rather than fail.
# The xUnit assembly fixture loads this file via DotNetEnv at test startup.


# ---------------------------------------------------------------------------
# Test behaviour — master switch
# ---------------------------------------------------------------------------

# Set to "true" to run integration tests that make real API calls and DB connections.
# When absent or "false", all integration tests are skipped.
SQLCHAT_RUN_INTEGRATION_TESTS=false


# ---------------------------------------------------------------------------
# LLM — Anthropic
# ---------------------------------------------------------------------------

# When set, enables: Anthropic connectivity test, Postgres end-to-end tests,
# and SQL Server end-to-end tests (if SQLCHAT_SQLSERVER_CONNECTION_STRING is also set).
# When absent or commented out, those tests are skipped rather than failed.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the model used during tests. Defaults to claude-haiku-4-5-20251001.
# Use a more capable model (e.g. claude-opus-4-7) for thorough runs.
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Optional: cap output tokens for test queries. Defaults to 2048.
# ANTHROPIC_MAX_OUTPUT_TOKENS=512


# ---------------------------------------------------------------------------
# LLM — OpenAI
# ---------------------------------------------------------------------------

# When set, enables the OpenAI connectivity test.
# When absent or commented out, the test is skipped rather than failed.
# OPENAI_API_KEY=sk-...

# Optional: override the model used during tests. Defaults to gpt-4o-mini.
# OPENAI_MODEL=gpt-4o-mini


# ---------------------------------------------------------------------------
# Database — PostgreSQL
# ---------------------------------------------------------------------------

# Required for any test that hits a real Postgres instance
# (schema introspection, query execution, end-to-end pipeline).
SQLCHAT_POSTGRES_CONNECTION_STRING=Host=localhost;Port=5432;Database=sqlchat_test;Username=postgres;Password=...


# ---------------------------------------------------------------------------
# Database — SQL Server
# ---------------------------------------------------------------------------

# When set (alongside ANTHROPIC_API_KEY), enables SQL Server connectivity and end-to-end tests.
# When absent or commented out, those tests are skipped rather than failed.
# LocalDB (ships with Visual Studio): Server=(localdb)\MSSQLLocalDB;Database=sqlchat_test;Integrated Security=true
# SQLCHAT_SQLSERVER_CONNECTION_STRING=Server=localhost,1433;Database=sqlchat_test;User Id=sa;Password=...;TrustServerCertificate=true


# ---------------------------------------------------------------------------
# Retry behaviour — optional overrides for test runs
# ---------------------------------------------------------------------------

# Max Polly retries on transient DB errors. Defaults to 3.
# Set lower (e.g. 1) to keep test runs fast.
# SQLCHAT_QUERY_RETRY_MAX=1

# Max LLM fix-and-retry loops when generated SQL fails at execution. Defaults to 2.
# SQLCHAT_LLM_FIX_RETRY_MAX=1
